{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "DeepGeminiProxy",
  "version": "1.0.2",
  "identifier": "com.lbjlaq.antigravity-tools",
  "build": {
    "beforeDevCommand": "npm run app2api:prepare && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run app2api:prepare && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "DeepGeminiProxy",
        "width": 1200,
        "height": 800,
        "center": true,
        "preventOverflow": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": false,
        "visible": false
      },
      {
        "label": "mini",
        "title": "DeepGeminiProxy Mini",
        "url": "index.html?mini=1",
        "width": 360,
        "height": 360,
        "decorations": false,
        "resizable": false,
        "shadow": true,
        "transparent": true,
        "alwaysOnTop": false,
        "visible": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/512x512.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/WebView2Loader.dll": "WebView2Loader.dll",
      "resources/app2api-runtime/": "app2api-runtime/"
    },
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "template": "installer.nsi"
      }
    },
    "macOS": {
      "entitlements": "Entitlements.plist"
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/swjybky/DeepGeminiProxy/releases/latest/download/updater.json"
      ],
      "dialog": true,
      "pubkey": ""
    },
    "process": null,
    "fs": null,
    "dialog": null,
    "opener": null,
    "single-instance": null
  }
}
